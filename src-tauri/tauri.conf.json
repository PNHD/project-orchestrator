{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Orchestrator",
  "version": "0.3.0",
  "identifier": "com.projectorchestrator.desktop",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:5173", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Project Orchestrator", "width": 1200, "height": 800, "minWidth": 390, "minHeight": 600, "resizable": true }], "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:5173; style-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.svg", "icons/icon.ico"] }
}
